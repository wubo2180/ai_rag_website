{
    "labelWidth": "100px",
    "labelPosition": "left",
    "sections": [
      {
        "title": "文献基本信息",
        "description": "填写论文的基本识别信息",
        "fields": [
          {
            "name": "article_id",
            "label": "文献编号",
            "type": "text",
            "required": true,
            "span": 12,
            "placeholder": "如：A1",
            "pattern": "^[A-Z]\\d+$",
            "patternMessage": "格式：大写字母+数字，如A1"
          },
          {
            "name": "article_name",
            "label": "文献名称",
            "type": "textarea",
            "required": true,
            "span": 24,
            "rows": 2,
            "placeholder": "请输入文献标题",
            "maxLength": 500
          },
          {
            "name": "performance_trend",
            "label": "性能趋势",
            "type": "textarea",
            "span": 24,
            "rows": 3,
            "placeholder": "请输入性能趋势描述",
            "maxLength": 1000
          }
        ]
      },
      {
        "title": "四级数据连接（Material-Intermediate-Property）",
        "description": "材料、中间体和性能数据的层次化关系",
        "fields": [
          {
            "name": "hierarchical_data",
            "label": "材料/中间体列表",
            "type": "array",
            "span": 24,
            "addButtonText": "添加材料/中间体",
            "itemTitle": "材料/中间体",
            "subFields": [
              {
                "name": "material_id",
                "label": "材料编号",
                "type": "text",
                "required": true,
                "span": 8,
                "placeholder": "如：A1M1",
                "pattern": "^[A-Z]\\d+M\\d+$",
                "patternMessage": "格式：A1M1"
              },
              {
                "name": "material_name",
                "label": "原材料名称",
                "type": "textarea",
                "span": 16,
                "rows": 1,
                "placeholder": "请输入原材料名称及规格"
              },
              {
                "name": "cas_number",
                "label": "CAS号",
                "type": "text",
                "span": 8,
                "placeholder": "如：1344-28-1"
              },
              {
                "name": "intermediate_id",
                "label": "中间体编号",
                "type": "text",
                "span": 8,
                "placeholder": "如：A1I1"
              },
              {
                "name": "intermediate_name",
                "label": "中间体名称",
                "type": "textarea",
                "span": 24,
                "rows": 2,
                "placeholder": "请输入中间体名称及组成"
              },
              {
                "name": "intermediate_composition",
                "label": "中间体组成",
                "type": "textarea",
                "span": 24,
                "rows": 1,
                "placeholder": "如：A1I1：A1I2=10:1（质量比）"
              },
              {
                "name": "properties",
                "label": "性能数据",
                "type": "table",
                "span": 24,
                "addButtonText": "添加性能",
                "columns": [
                  {
                    "name": "property_id",
                    "label": "性能编号",
                    "type": "text",
                    "width": 120,
                    "placeholder": "如：A1P1"
                  },
                  {
                    "name": "property_name",
                    "label": "性能名称",
                    "type": "text",
                    "minWidth": 200,
                    "placeholder": "如：粘度／黏度 MPa·S"
                  },
                  {
                    "name": "property_value",
                    "label": "性能值",
                    "type": "text",
                    "width": 150,
                    "placeholder": "如：1900"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }