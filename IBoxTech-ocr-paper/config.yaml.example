# Dify API 配置文件
# 复制此文件为 config.yaml 并填写实际配置
dify:
  base_url: "http://YOUR_DIFY_HOST:8088"
  api_key: "app-YOUR_API_KEY_HERE"
  default_user: "difyuser"

  upload:
    endpoint: "/v1/files/upload"
    allowed_extensions:
      - pdf
      - txt
      - doc
      - docx
    max_file_size: 50

  workflow:
    endpoint: "/v1/workflows/run"
    response_mode: "blocking"
    transfer_method: "local_file"
    file_type: "document"

api:
  host: "0.0.0.0"
  port: 8000
  debug: true
  enable_cors: true
  temp_upload_dir: "./temp_uploads"
